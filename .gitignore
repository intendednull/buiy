.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

.worktrees/

.superpowers/

target/
# Cargo.lock IS committed — this workspace ships binaries (the examples/*), so a
# pinned lockfile is required for reproducible builds and a stable cargo-deny
# audit surface (Cargo Book FAQ). CI builds with --locked against it.

# Pending (unaccepted) insta snapshots — never committed; `cargo insta review`
# either accepts them into the committed `.snap` or discards them. A CI guard
# fails if any are present (see ci.yml snapshot-hygiene step).
*.snap.new

# trunk web build output (WebGPU/WebGL2 wasm artifacts + the two-artifact loader,
# produced by `trunk build --features …` / `tools/build-web.sh`) — never committed.
examples/*/dist/
examples/*/dist-web/
examples/*/dist-webgl2/
examples/*/dist-webgpu/

# App-1 lane artifacts (not committed)
PR_BODY.md

# Live dooduel_server runtime config (local per-run knobs; the committed reference is
# apps/dooduel_server/dooduel_server.example.toml).
/dooduel_server.toml
